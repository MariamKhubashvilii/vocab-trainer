{
  "hosting": {
    "site": "vocab-trainer-mk",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.py",
      "__pycache__/**",
      "**/*.bak*",
      "words-browser.html",
      "words-database.xlsx",
      "README.md",
      "data/progress.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
